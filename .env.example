# ==============================================================================
# BOLDDEE RENTALS — PRODUCTION ENVIRONMENT CONFIGURATION
# Conforms to SRS Security & Integration Specifications
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication & Session Security (NFR-004)
# Generate a cryptographically secure random 64-char hex string in production:
JWT_SECRET=bolddee_prod_jwt_secret_change_me_before_production_2026_xyz
ADMIN_SECRET_KEY=bolddee2026

# Database Path (SQLite / PostgreSQL Compatible)
DATABASE_URL=data/bolddee.db

# Paystack Ghana Payment Gateway Integration (§25, FR-023)
# Register at paystack.com for live credentials:
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signing_secret_here

# WhatsApp & Operations Hotline (+233 format)
WHATSAPP_PHONE=233546996210
WHATSAPP_DISPATCH_PHONE=233244163901

# System Default Parameters (§46, BR-001, BR-002)
DEFAULT_DEPOSIT_PERCENT=60
DEFAULT_BALANCE_DEADLINE_HOURS=48
DEFAULT_CHECKOUT_HOLD_MINUTES=30
DEFAULT_SETUP_BUFFER_DAYS=1
DEFAULT_PICKUP_BUFFER_DAYS=1
